{
	"info": {
		"name": "SnapRender API",
		"description": "Screenshot any website via API. Supports PNG, JPEG, WebP, and PDF output with device emulation, dark mode, ad blocking, and cookie banner removal.\n\n**Base URL:** `https://app.snap-render.com`\n\n**Authentication:** Pass your API key in the `X-API-Key` header.\n\n**Get a free API key:** https://app.snap-render.com/auth/signup (50 free screenshots/month, no credit card required)\n\n**Documentation:** https://app.snap-render.com\n\n**SDKs:**\n- Node.js: `npm install snaprender`\n- Python: `pip install snaprender`",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "apikey",
		"apikey": [
			{
				"key": "key",
				"value": "X-API-Key",
				"type": "string"
			},
			{
				"key": "value",
				"value": "{{api_key}}",
				"type": "string"
			},
			{
				"key": "in",
				"value": "header",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "https://app.snap-render.com",
			"type": "string"
		},
		{
			"key": "api_key",
			"value": "YOUR_API_KEY",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Screenshot",
			"item": [
				{
					"name": "Take Screenshot (PNG)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/screenshot?url=https://example.com&format=png&width=1280&height=800",
							"host": ["{{base_url}}"],
							"path": ["v1", "screenshot"],
							"query": [
								{
									"key": "url",
									"value": "https://example.com",
									"description": "Required. The URL to capture."
								},
								{
									"key": "format",
									"value": "png",
									"description": "Output format: png, jpeg, webp, or pdf. Default: png."
								},
								{
									"key": "width",
									"value": "1280",
									"description": "Viewport width in pixels (320-3840). Default: 1280."
								},
								{
									"key": "height",
									"value": "800",
									"description": "Viewport height in pixels (200-10000). Default: 800."
								}
							]
						},
						"description": "Capture a basic PNG screenshot of a website."
					}
				},
				{
					"name": "Screenshot from HTML (POST)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"html\": \"<html><body><h1>Hello World</h1><p>Rendered from raw HTML.</p></body></html>\",\n  \"format\": \"png\",\n  \"width\": 800,\n  \"height\": 600\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/screenshot",
							"host": ["{{base_url}}"],
							"path": ["v1", "screenshot"]
						},
						"description": "Render raw HTML content and capture as a screenshot. Uses POST with JSON body."
					}
				},
				{
					"name": "Screenshot from Markdown (POST)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"markdown\": \"# Hello World\\n\\nThis is **bold** and this is `code`.\\n\\n```js\\nconsole.log(42);\\n```\",\n  \"format\": \"png\",\n  \"width\": 800,\n  \"height\": 600\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/screenshot",
							"host": ["{{base_url}}"],
							"path": ["v1", "screenshot"]
						},
						"description": "Render Markdown content with a styled template and capture as a screenshot. Uses POST with JSON body."
					}
				},
				{
					"name": "Screenshot URL via POST",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"url\": \"https://example.com\",\n  \"format\": \"png\",\n  \"width\": 1280,\n  \"height\": 800,\n  \"dark_mode\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/screenshot",
							"host": ["{{base_url}}"],
							"path": ["v1", "screenshot"]
						},
						"description": "Capture a URL screenshot using POST with JSON body. Same as GET but with native boolean/number types."
					}
				},
				{
					"name": "Take Screenshot (WebP)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/screenshot?url=https://example.com&format=webp&quality=85&width=1920&height=1080",
							"host": ["{{base_url}}"],
							"path": ["v1", "screenshot"],
							"query": [
								{
									"key": "url",
									"value": "https://example.com"
								},
								{
									"key": "format",
									"value": "webp"
								},
								{
									"key": "quality",
									"value": "85",
									"description": "Image quality 1-100. Default: 90."
								},
								{
									"key": "width",
									"value": "1920"
								},
								{
									"key": "height",
									"value": "1080"
								}
							]
						},
						"description": "Capture a WebP screenshot with custom quality. WebP produces 25-50% smaller files than PNG."
					}
				},
				{
					"name": "Take Screenshot (PDF)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/screenshot?url=https://example.com&format=pdf",
							"host": ["{{base_url}}"],
							"path": ["v1", "screenshot"],
							"query": [
								{
									"key": "url",
									"value": "https://example.com"
								},
								{
									"key": "format",
									"value": "pdf"
								}
							]
						},
						"description": "Generate a PDF document of a web page."
					}
				},
				{
					"name": "Full-Page Screenshot",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/screenshot?url=https://example.com&format=png&full_page=true",
							"host": ["{{base_url}}"],
							"path": ["v1", "screenshot"],
							"query": [
								{
									"key": "url",
									"value": "https://example.com"
								},
								{
									"key": "format",
									"value": "png"
								},
								{
									"key": "full_page",
									"value": "true",
									"description": "Capture the entire scrollable page. Default: false."
								}
							]
						},
						"description": "Capture the entire scrollable page, not just the visible viewport."
					}
				},
				{
					"name": "Dark Mode Screenshot",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/screenshot?url=https://example.com&format=png&dark_mode=true",
							"host": ["{{base_url}}"],
							"path": ["v1", "screenshot"],
							"query": [
								{
									"key": "url",
									"value": "https://example.com"
								},
								{
									"key": "format",
									"value": "png"
								},
								{
									"key": "dark_mode",
									"value": "true",
									"description": "Emulate prefers-color-scheme: dark. Default: false."
								}
							]
						},
						"description": "Capture a page in dark mode (for sites that support prefers-color-scheme: dark)."
					}
				},
				{
					"name": "Mobile Screenshot (iPhone 15 Pro)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/screenshot?url=https://example.com&format=png&device=iphone_15_pro",
							"host": ["{{base_url}}"],
							"path": ["v1", "screenshot"],
							"query": [
								{
									"key": "url",
									"value": "https://example.com"
								},
								{
									"key": "format",
									"value": "png"
								},
								{
									"key": "device",
									"value": "iphone_15_pro",
									"description": "Device preset: iphone_14, iphone_15_pro, pixel_7, ipad_pro, macbook_pro."
								}
							]
						},
						"description": "Capture a page as it appears on an iPhone 15 Pro (393x852, 3x DPR, mobile user agent)."
					}
				},
				{
					"name": "Screenshot with All Options",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/screenshot?url=https://example.com&format=webp&width=1920&height=1080&quality=90&full_page=false&dark_mode=false&block_ads=true&block_cookie_banners=true&delay=0&cache=true&cache_ttl=86400&response_type=binary",
							"host": ["{{base_url}}"],
							"path": ["v1", "screenshot"],
							"query": [
								{
									"key": "url",
									"value": "https://example.com",
									"description": "Required. URL to capture."
								},
								{
									"key": "format",
									"value": "webp",
									"description": "png, jpeg, webp, or pdf. Default: png."
								},
								{
									"key": "width",
									"value": "1920",
									"description": "Viewport width 320-3840. Default: 1280."
								},
								{
									"key": "height",
									"value": "1080",
									"description": "Viewport height 200-10000. Default: 800."
								},
								{
									"key": "quality",
									"value": "90",
									"description": "Image quality 1-100. Default: 90."
								},
								{
									"key": "full_page",
									"value": "false",
									"description": "Capture full scrollable page. Default: false."
								},
								{
									"key": "dark_mode",
									"value": "false",
									"description": "Dark mode emulation. Default: false."
								},
								{
									"key": "block_ads",
									"value": "true",
									"description": "Block ads and trackers. Default: true."
								},
								{
									"key": "block_cookie_banners",
									"value": "true",
									"description": "Remove cookie consent banners. Default: true."
								},
								{
									"key": "delay",
									"value": "0",
									"description": "Wait ms after page load before capture (0-10000). Default: 0."
								},
								{
									"key": "cache",
									"value": "true",
									"description": "Enable R2 caching. Default: true."
								},
								{
									"key": "cache_ttl",
									"value": "86400",
									"description": "Cache TTL in seconds (clamped to plan max). Default: 86400."
								},
								{
									"key": "response_type",
									"value": "binary",
									"description": "Response format: binary (raw image) or json (base64 data URI with metadata). Default: binary."
								}
							]
						},
						"description": "Screenshot with every available parameter. Modify as needed."
					}
				},
				{
					"name": "Screenshot Info (Cache Check)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/screenshot/info?url=https://example.com&format=png&width=1280&height=800",
							"host": ["{{base_url}}"],
							"path": ["v1", "screenshot", "info"],
							"query": [
								{
									"key": "url",
									"value": "https://example.com"
								},
								{
									"key": "format",
									"value": "png"
								},
								{
									"key": "width",
									"value": "1280"
								},
								{
									"key": "height",
									"value": "800"
								}
							]
						},
						"description": "Check if a screenshot is cached and validate parameters without capturing. Does not count against quota."
					}
				}
			],
			"description": "Capture website screenshots in PNG, JPEG, WebP, or PDF format."
		},
		{
			"name": "Signed URLs",
			"item": [
				{
					"name": "Generate Signed URL",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"url\": \"https://example.com\",\n  \"expires_in\": 86400\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/screenshot/sign",
							"host": ["{{base_url}}"],
							"path": ["v1", "screenshot", "sign"]
						},
						"description": "Generate a pre-signed URL that can render a screenshot without an API key. Signing is free and does not count against quota. The signed URL consumes one credit when rendered."
					}
				},
				{
					"name": "Generate Signed URL (Custom)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"url\": \"https://example.com\",\n  \"expires_in\": 604800,\n  \"format\": \"jpeg\",\n  \"width\": 1920,\n  \"height\": 1080,\n  \"dark_mode\": true,\n  \"block_ads\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/screenshot/sign",
							"host": ["{{base_url}}"],
							"path": ["v1", "screenshot", "sign"]
						},
						"description": "Generate a signed URL with custom screenshot settings and 7-day expiry."
					}
				},
				{
					"name": "Render Signed URL",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/screenshot/render?url=https%3A%2F%2Fexample.com&expires=PASTE_EXPIRES&key_prefix=PASTE_PREFIX&sig=PASTE_SIG",
							"host": ["{{base_url}}"],
							"path": ["v1", "screenshot", "render"],
							"query": [
								{ "key": "url", "value": "https%3A%2F%2Fexample.com" },
								{ "key": "expires", "value": "PASTE_EXPIRES" },
								{ "key": "key_prefix", "value": "PASTE_PREFIX" },
								{ "key": "sig", "value": "PASTE_SIG" }
							]
						},
						"description": "Render a screenshot using a signed URL. No API key required. Paste the values from the sign response."
					}
				}
			],
			"description": "Generate and use pre-signed URLs for sharing screenshots without exposing your API key."
		},
		{
			"name": "Content Extraction",
			"item": [
				{
					"name": "Extract Markdown",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/extract?url=https://example.com&type=markdown",
							"host": ["{{base_url}}"],
							"path": ["v1", "extract"],
							"query": [
								{ "key": "url", "value": "https://example.com" },
								{ "key": "type", "value": "markdown" }
							]
						},
						"description": "Extract readable content as Markdown from any web page."
					}
				},
				{
					"name": "Extract Article",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"url\": \"https://example.com\",\n  \"type\": \"article\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/extract",
							"host": ["{{base_url}}"],
							"path": ["v1", "extract"]
						},
						"description": "Extract structured article with title, author, excerpt, and content."
					}
				},
				{
					"name": "Extract Metadata",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/extract?url=https://example.com&type=metadata",
							"host": ["{{base_url}}"],
							"path": ["v1", "extract"],
							"query": [
								{ "key": "url", "value": "https://example.com" },
								{ "key": "type", "value": "metadata" }
							]
						},
						"description": "Extract page metadata including title, description, and OG/Twitter tags."
					}
				},
				{
					"name": "Extract Links",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/extract?url=https://example.com&type=links",
							"host": ["{{base_url}}"],
							"path": ["v1", "extract"],
							"query": [
								{ "key": "url", "value": "https://example.com" },
								{ "key": "type", "value": "links" }
							]
						},
						"description": "Extract all links from a web page with their anchor text."
					}
				},
				{
					"name": "Extract with Selector",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"url\": \"https://example.com\",\n  \"type\": \"text\",\n  \"selector\": \"#main-content\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/extract",
							"host": ["{{base_url}}"],
							"path": ["v1", "extract"]
						},
						"description": "Extract text from a specific page element using a CSS selector."
					}
				}
			],
			"description": "Extract structured content from web pages. Supports markdown, text, html, article, links, and metadata extraction."
		},
		{
			"name": "Usage",
			"item": [
				{
					"name": "Get Current Usage",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/usage",
							"host": ["{{base_url}}"],
							"path": ["v1", "usage"]
						},
						"description": "Get current month's usage statistics including screenshots used, limit, and remaining."
					}
				},
				{
					"name": "Get Daily Usage",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/usage/daily?days=30",
							"host": ["{{base_url}}"],
							"path": ["v1", "usage", "daily"],
							"query": [
								{
									"key": "days",
									"value": "30",
									"description": "Number of days to look back (1-90). Default: 30."
								}
							]
						},
						"description": "Get daily usage breakdown for the past N days. Useful for building usage charts."
					}
				}
			],
			"description": "Check your API usage and quota."
		},
		{
			"name": "Batch Screenshots",
			"item": [
				{
					"name": "Create Batch Job",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"urls\": [\n    \"https://example.com\",\n    \"https://github.com\",\n    \"https://google.com\"\n  ],\n  \"format\": \"png\",\n  \"width\": 1280,\n  \"height\": 800\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/screenshot/batch",
							"host": ["{{base_url}}"],
							"path": ["v1", "screenshot", "batch"]
						},
						"description": "Create a batch screenshot job for up to 50 URLs. Returns a job ID immediately. Poll the status endpoint to track progress and get download URLs."
					}
				},
				{
					"name": "Get Batch Status",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/screenshot/batch/{{batch_job_id}}",
							"host": ["{{base_url}}"],
							"path": ["v1", "screenshot", "batch", "{{batch_job_id}}"]
						},
						"description": "Poll the status of a batch screenshot job. Returns progress, completed download URLs, and any errors."
					}
				},
				{
					"name": "Batch with Options",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"urls\": [\n    \"https://example.com\",\n    \"https://github.com\"\n  ],\n  \"format\": \"jpeg\",\n  \"width\": 1920,\n  \"height\": 1080,\n  \"full_page\": true,\n  \"dark_mode\": true,\n  \"quality\": 80\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/screenshot/batch",
							"host": ["{{base_url}}"],
							"path": ["v1", "screenshot", "batch"]
						},
						"description": "Create a batch job with custom screenshot options applied to all URLs."
					}
				}
			],
			"description": "Batch screenshot processing. Submit multiple URLs and poll for results."
		},
		{
			"name": "Webhooks",
			"item": [
				{
					"name": "Create Webhook",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"url\": \"https://your-server.com/webhook\",\n  \"events\": [\"screenshot.completed\", \"quota.warning\"]\n}"
						},
						"url": {
							"raw": "{{base_url}}/v1/webhooks",
							"host": ["{{base_url}}"],
							"path": ["v1", "webhooks"]
						},
						"description": "Register a webhook URL to receive event notifications. Max 5 per account. Save the returned secret for signature verification."
					}
				},
				{
					"name": "List Webhooks",
					"request": {
						"method": "GET",
